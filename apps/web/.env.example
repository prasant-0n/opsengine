# ==============================================================================
# OpsEngine Enterprise SaaS — Environment Variables Template (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL 18+)
DATABASE_URL=postgresql://opsengine:opsengine@localhost:5432/opsengine

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Outbound Notifications & Email (AWS Simple Email Service - SES)
# ==============================================================================
# Required only if you wish to enable production outbound email dispatches.
# If left blank, notifications remain fully operational via the In-App Inbox.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@opsengine.enterprise

# ==============================================================================
# Controlled AI Assistant (Google AI Studio / Gemini API)
# ==============================================================================
# Required for AI Assistant features after an operator enables AI for the tenant.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
