generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TenantWorkspace {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  slug      String
  domain    String?
  isActive        Boolean   @default(true)
  aiEnabled       Boolean   @default(false) @map("ai_enabled")
  lifecycleStatus String    @default("active") @map("lifecycle_status") // provisioning | active | suspended | offboarding | closed
  suspendedReason String?   @map("suspended_reason")
  suspendedAt     DateTime? @db.Timestamptz(6) @map("suspended_at")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  @@index([tenantId, slug], map: "idx_tenant_workspaces_tenant_slug")
  @@index([tenantId, domain], map: "idx_tenant_workspaces_tenant_domain")
  @@map("tenant_workspaces")
}

model AuthUser {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  email            String
  passwordHash     String?  @map("password_hash")
  isRootAdmin      Boolean  @default(false) @map("is_root_admin")
  isSuperadmin     Boolean  @default(false) @map("is_superadmin")
  breakGlassEnabled Boolean @default(false) @map("break_glass_enabled")
  oauthProvider     String?  @map("oauth_provider")
  oauthSubject      String?  @map("oauth_subject")
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenantId, email], map: "idx_auth_users_tenant_email")
  @@index([tenantId, oauthProvider, oauthSubject], map: "idx_auth_users_tenant_oauth")
  @@map("auth_users")
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  code      String
  purpose   String
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  usedAt    DateTime? @db.Timestamptz(6) @map("used_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, userId, purpose], map: "idx_otp_codes_tenant_user_purpose")
  @@index([expiresAt], map: "idx_otp_codes_expires_at")
  @@map("otp_codes")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  tenantId  String    @db.Uuid
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(6) @map("expires_at")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedBy String?   @db.Uuid @map("revoked_by")
  userAgent String?   @map("user_agent")
  ip        String?

  @@index([token], map: "idx_sessions_token")
  @@index([tenantId], map: "idx_sessions_tenant_id")
  @@index([tenantId, userId, revokedAt], map: "idx_sessions_tenant_user_active")
  @@map("sessions")
}

model ResetToken {
  token      String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tenantId   String   @db.Uuid
  expiresAt  DateTime @db.Timestamptz(6) @map("expires_at")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  usedAt     DateTime? @db.Timestamptz(6) @map("used_at")

  @@index([tenantId], map: "idx_reset_tokens_tenant_id")
  @@map("reset_tokens")
}

// ---------- Feature #2: Authorization Core (authz-core) ----------

model TenantMembership {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  userId     String    @db.Uuid @map("user_id")
  employeeId String?   @db.Uuid @map("employee_id")
  status     String    @default("active") // active | suspended | left
  joinedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("joined_at")
  leftAt     DateTime? @db.Timestamptz(6) @map("left_at")

  @@unique([tenantId, userId], map: "uq_tenant_memberships_tenant_user")
  @@index([tenantId, status], map: "idx_tenant_memberships_tenant_status")
  @@map("tenant_memberships")
}

// ---------- Feature #4: Employee & HRMS core (Module 2 slice) ----------
// employmentStatus values: preboarding | active | probation | notice | exited
// plus legacy: on_leave | terminated (accepted, never rejected)

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid @map("tenant_id")
  userId           String?   @db.Uuid @map("user_id")
  displayName      String    @map("display_name")
  employeeNumber   String?   @map("employee_number")
  workEmail        String?   @map("work_email")
  jobTitle         String?   @map("job_title")
  jobFamily        String?   @map("job_family")
  grade            String?
  seniority        String?
  department       String?
  sbuId            String?   @db.Uuid @map("sbu_id")
  employmentType   String?   @map("employment_type") // full_time | part_time | contract | intern
  location         String?
  startDate        DateTime? @db.Timestamptz(6) @map("start_date")
  probationEndsAt  DateTime? @db.Timestamptz(6) @map("probation_ends_at")
  employmentStatus String    @default("active") @map("employment_status")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, employeeNumber], map: "uq_employees_tenant_number")
  @@index([tenantId, userId], map: "idx_employees_tenant_user")
  @@index([tenantId, employmentStatus], map: "idx_employees_tenant_status")
  @@map("employees")
}

model Team {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid @map("tenant_id")
  name          String
  teamType      String?   @map("team_type")
  parentTeamId  String?   @db.Uuid @map("parent_team_id")
  sbuId         String?   @db.Uuid @map("sbu_id")
  validFrom     DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo       DateTime? @db.Timestamptz(6) @map("valid_to")

  @@index([tenantId, name], map: "idx_teams_tenant_name")
  @@map("teams")
}

model EmployeeTeamMembership {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid @map("tenant_id")
  employeeId     String    @db.Uuid @map("employee_id")
  teamId         String    @db.Uuid @map("team_id")
  membershipType String    @default("primary") @map("membership_type") // primary | secondary | project | temporary
  responsibility String    @default("member") // member | coordinator | team_lead
  validFrom      DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo        DateTime? @db.Timestamptz(6) @map("valid_to")

  @@index([tenantId, employeeId, validFrom], map: "idx_etm_tenant_employee")
  @@index([tenantId, teamId, responsibility], map: "idx_etm_tenant_team")
  @@map("employee_team_memberships")
}

model ReportingRelationship {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid @map("tenant_id")
  managerEmployeeId  String    @db.Uuid @map("manager_employee_id")
  reportEmployeeId   String    @db.Uuid @map("report_employee_id")
  relationshipType   String    @default("direct") @map("relationship_type") // direct | dotted | acting | project
  scope              String?
  validFrom          DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo            DateTime? @db.Timestamptz(6) @map("valid_to")

  @@index([tenantId, managerEmployeeId, validFrom], map: "idx_rr_tenant_manager")
  @@index([tenantId, reportEmployeeId, validFrom], map: "idx_rr_tenant_report")
  @@map("reporting_relationships")
}

model AccessGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  purpose   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, name], map: "idx_access_groups_tenant_name")
  @@map("access_groups")
}

model AccessGroupMembership {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid @map("tenant_id")
  groupId    String    @db.Uuid @map("group_id")
  employeeId String    @db.Uuid @map("employee_id")
  source     String    @default("manual") // manual | rule
  validFrom  DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo    DateTime? @db.Timestamptz(6) @map("valid_to")

  @@index([tenantId, groupId, employeeId], map: "idx_agm_tenant_group")
  @@map("access_group_memberships")
}

model RoleGrant {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid @map("tenant_id")
  principalUserId      String    @db.Uuid @map("principal_user_id")
  principalEmployeeId  String?   @db.Uuid @map("principal_employee_id")
  roleKey              String    @map("role_key")
  scopeType            String    @map("scope_type") // SELF | TEAM | REPORTING_TREE | SBU | PROJECT | GROUP | ASSIGNED_CASE | TENANT
  scopeId              String?   @db.Uuid @map("scope_id")
  validFrom            DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo              DateTime? @db.Timestamptz(6) @map("valid_to")
  grantedBy            String?   @db.Uuid @map("granted_by")
  reason               String?
  auditRef             String?   @map("audit_ref")

  @@index([tenantId, principalUserId, roleKey], map: "idx_role_grants_tenant_principal")
  @@map("role_grants")
}

model PermissionGrant {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid @map("tenant_id")
  principalUserId      String    @db.Uuid @map("principal_user_id")
  principalEmployeeId  String?   @db.Uuid @map("principal_employee_id")
  permissionKey        String    @map("permission_key")
  scopeType            String    @map("scope_type")
  scopeId              String?   @db.Uuid @map("scope_id")
  validFrom            DateTime  @default(now()) @db.Timestamptz(6) @map("valid_from")
  validTo              DateTime? @db.Timestamptz(6) @map("valid_to")
  grantedBy            String?   @db.Uuid @map("granted_by")
  reason               String?
  auditRef             String?   @map("audit_ref")

  @@index([tenantId, principalUserId, permissionKey], map: "idx_perm_grants_tenant_principal")
  @@map("permission_grants")
}

model PolicyVersion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  version   Int
  rules     Json
  active    Boolean  @default(false)
  createdBy String?  @db.Uuid @map("created_by")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenantId, version], map: "uq_policy_versions_tenant_version")
  @@map("policy_versions")
}

model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid @map("tenant_id")
  actorUserId    String?   @db.Uuid @map("actor_user_id")
  eventType      String    @map("event_type")
  resourceType   String?   @map("resource_type")
  resourceId     String?   @db.Uuid @map("resource_id")
  decision       String?
  reasonCode     String?   @map("reason_code")
  policyVersion  Int?      @map("policy_version")
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tenantId, eventType, createdAt], map: "idx_audit_events_tenant_type_time")
  @@map("audit_events")
}

// ---------- Feature #5: ATS / Recruitment (Module 3) ----------

model Requisition {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid @map("tenant_id")
  code             String?
  jobTitle         String    @map("job_title")
  jobFamily        String?   @map("job_family")
  grade            String?
  headcount        Int       @default(1)
  budgetBand       String?   @map("budget_band")
  hiringManagerId  String?   @db.Uuid @map("hiring_manager_id")
  justification    String?   @db.Text
  expectedStartDate DateTime? @db.Timestamptz(6) @map("expected_start_date")
  status           String    @default("draft") // draft | submitted | approved | rejected | closed
  approvedBy       String?   @db.Uuid @map("approved_by")
  approvedAt       DateTime? @db.Timestamptz(6) @map("approved_at")
  createdBy        String?   @db.Uuid @map("created_by")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, status, createdAt], map: "idx_req_tenant_status_created")
  @@map("requisitions")
}

model Candidate {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid @map("tenant_id")
  fullName            String    @map("full_name")
  email               String
  phone               String?
  source              String?
  resumeUrl           String?   @map("resume_url")
  consentGiven        Boolean   @default(false) @map("consent_given")
  consentAt           DateTime? @db.Timestamptz(6) @map("consent_at")
  consentIp           String?   @map("consent_ip")
  status              String    @default("applied") // applied | screening | rejected | withdrawn | offer_made | accepted
  linkedRequisitionId String?   @db.Uuid @map("linked_requisition_id")
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, email, status], map: "idx_cand_tenant_email_status")
  @@map("candidates")
}

model Interview {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid @map("tenant_id")
  requisitionId String?   @db.Uuid @map("requisition_id")
  candidateId   String?   @db.Uuid @map("candidate_id")
  type          String    @default("phone") // phone | technical | managerial | hr
  startAt       DateTime  @db.Timestamptz(6) @map("start_at")
  endAt         DateTime  @db.Timestamptz(6) @map("end_at")
  timezone      String    @default("UTC")
  location      String?
  meetingLink   String?   @map("meeting_link")
  status        String    @default("scheduled") // scheduled | completed | cancelled | no_show
  createdBy     String?   @db.Uuid @map("created_by")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([tenantId, candidateId, startAt], map: "idx_intv_tenant_cand_start")
  @@map("interviews")
}

model InterviewPanelMember {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  interviewId String   @db.Uuid @map("interview_id")
  employeeId  String   @db.Uuid @map("employee_id")
  role        String   @default("interviewer")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@unique([tenantId, interviewId, employeeId], map: "uq_ipm_tenant_interview_emp")
  @@map("interview_panel_members")
}

model InterviewFeedback {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  interviewId   String   @db.Uuid @map("interview_id")
  interviewerId String   @db.Uuid @map("interviewer_id")
  rating        Int
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, interviewId, interviewerId], map: "idx_ifb_tenant_interview_intr")
  @@map("interview_feedback")
}

// ---- Feature #6: CRM core (PRD Module 9) ----

model CrmAccount {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  name       String
  industry   String?
  website    String?
  source     String   @default("inbound")
  status     String   @default("prospect") // prospect | active | on_hold | churned
  clientTier String?  @map("client_tier") // standard | strategic
  ownerId    String   @db.Uuid @map("owner_id")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt  DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, status, createdAt], map: "idx_crm_acc_tenant_status_created")
  @@map("crm_accounts")
}

model CrmContact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  accountId String   @db.Uuid @map("account_id")
  fullName  String   @map("full_name")
  email     String
  phone     String?
  title     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, accountId], map: "idx_crm_con_tenant_account")
  @@map("crm_contacts")
}

model CrmLead {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid @map("tenant_id")
  fullName             String    @map("full_name")
  email                String?
  phone                String?
  company              String?
  source               String    @default("inbound")
  status               String    @default("new") // new | working | qualified | unqualified | converted
  ownerId              String    @db.Uuid @map("owner_id")
  nextAction           String?   @map("next_action")
  nextActionAt         DateTime? @db.Timestamptz(6) @map("next_action_at")
  notes                String?   @db.Text
  convertedAccountId   String?   @db.Uuid @map("converted_account_id")
  convertedContactId   String?   @db.Uuid @map("converted_contact_id")
  convertedOpportunityId String? @db.Uuid @map("converted_opportunity_id")
  createdAt            DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, status, createdAt], map: "idx_crm_lead_tenant_status_created")
  @@map("crm_leads")
}

model CrmOpportunity {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid @map("tenant_id")
  accountId        String    @db.Uuid @map("account_id")
  name             String
  stage            String    @default("prospecting") // prospecting | qualification | proposal | negotiation | won | lost
  amountCents      BigInt    @default(0) @db.BigInt @map("amount_cents") // integer cents; never binary float
  currency         String    @default("USD")
  expectedCloseDate DateTime? @db.Timestamptz(6) @map("expected_close_date")
  probability       Int?
  forecastCategory String?   @map("forecast_category") // pipeline | best_case | commit | closed
  ownerId          String    @db.Uuid @map("owner_id")
  lostReason       String?   @db.Text @map("lost_reason")
  competitorNotes  String?   @db.Text @map("competitor_notes")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, stage, createdAt], map: "idx_crm_opp_tenant_stage_created")
  @@map("crm_opportunities")
}

// ---- Feature #7: Project & Workforce Management (PRD Modules 8 + 7 + 11) ----

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid @map("tenant_id")
  name           String
  code           String
  accountId      String?   @db.Uuid @map("account_id")
  ownerId        String    @db.Uuid @map("owner_id")
  deliveryLeadId String?   @db.Uuid @map("delivery_lead_id")
  startDate      DateTime? @db.Timestamptz(6) @map("start_date")
  endDate        DateTime? @db.Timestamptz(6) @map("end_date")
  budgetCents    BigInt?   @db.BigInt @map("budget_cents")
  status         String    @default("proposed") // proposed | pending_approval | approved | active | on_hold | completed | cancelled
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@unique([tenantId, code], map: "uq_proj_tenant_code")
  @@index([tenantId, status, createdAt], map: "idx_proj_tenant_status_created")
  @@map("projects")
}

model Ticket {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid @map("tenant_id")
  projectId    String?   @db.Uuid @map("project_id")
  accountId    String?   @db.Uuid @map("account_id")
  title        String
  description  String?   @db.Text
  type         String    @default("task") // bug | feature | task | incident | support
  status       String    @default("open") // open | triaged | in_progress | in_review | resolved | closed
  priority     String    @default("medium") // low | medium | high | critical
  assigneeId   String?   @db.Uuid @map("assignee_id")
  reporterId   String?   @db.Uuid @map("reporter_id")
  slaDueAt     DateTime? @db.Timestamptz(6) @map("sla_due_at")
  closedReason String?   @db.Text @map("closed_reason")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, status, createdAt], map: "idx_ticket_tenant_status_created")
  @@index([tenantId, projectId], map: "idx_ticket_tenant_project")
  @@index([tenantId, accountId], map: "idx_ticket_tenant_account")
  @@map("tickets")
}

model Allocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  projectId String   @db.Uuid @map("project_id")
  employeeId String  @db.Uuid @map("employee_id")
  percentage Int
  startDate DateTime @db.Timestamptz(6) @map("start_date")
  endDate   DateTime @db.Timestamptz(6) @map("end_date")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([tenantId, employeeId, startDate, endDate], map: "idx_alloc_tenant_emp_dates")
  @@index([tenantId, projectId], map: "idx_alloc_tenant_project")
  @@map("allocations")
}

model ProjectMilestone {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  projectId String   @db.Uuid @map("project_id")
  name      String
  dueDate   DateTime? @db.Timestamptz(6) @map("due_date")
  status    String   @default("pending") // pending | in_progress | completed | missed
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

