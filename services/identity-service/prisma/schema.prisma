model ProbationReview {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid @map("tenant_id")
  planId              String    @db.Uuid @map("plan_id")
  startOn             DateTime  @map("start_on") @db.Timestamptz(6)
  dueOn               DateTime  @map("due_on") @db.Timestamptz(6)
  endOn               DateTime? @map("end_on") @db.Timestamptz(6)
  managerEmployeeId   String?   @db.Uuid @map("manager_employee_id")
  employeeReviewerId  String?   @db.Uuid @map("employee_reviewer_id")
  status              String    @default("pending") // pending | in_review | completed
  recommendation      String? // confirm | extend | terminate
  outcome             String?
  managerFeedback     String?   @map("manager_feedback") @db.Text
  employeeFeedback    String?   @map("employee_feedback") @db.Text
  decidedBy           String?   @db.Uuid @map("decided_by")
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  newEndOn            DateTime? @map("new_end_on") @db.Timestamptz(6)
