{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXTAUTH_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NODE_ENV",
    "CI",
    "AWS_SES_REGION",
    "AWS_SES_ACCESS_KEY_ID",
    "AWS_SES_SECRET_ACCESS_KEY",
    "AWS_SES_FROM_EMAIL",
    "CLOUDFLARE_R2_ACCOUNT_ID",
    "CLOUDFLARE_R2_ACCESS_KEY_ID",
    "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
    "CLOUDFLARE_R2_BUCKET_NAME",
    "CLOUDFLARE_R2_PUBLIC_URL",
    "MOCK_GOOGLE_SSO",
    "APP_VERSION",
    "GEMINI_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_OAUTH_REDIRECT_URI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NODE_ENV",
        "MOCK_GOOGLE_SSO",
        "APP_VERSION",
        "GEMINI_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI"
      ]
    },
    "@opsengine/identity-service#build": {
      "cache": false
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "CI",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false
    },
    "db:migrate": {
      "passThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL"
      ]
    }
  },
  "globalDependencies": [
    ".env*"
  ]
}
