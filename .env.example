# AWS SES Email Configuration

Copy to `.env` at repo root and fill in values.

# Database (Neon Serverless Postgres / Local)
DATABASE_URL=postgresql://opsengine:opsengine@localhost:5432/opsengine
# Direct connection URL for Prisma migrations (Neon direct URL bypasses PgBouncer pooler)
DIRECT_URL=postgresql://opsengine:opsengine@localhost:5432/opsengine

# Cloudflare R2 Object Storage (100% S3 Compatible, 10 GB Free Tier, Zero Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=opsengine-documents
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourdomain.r2.dev

# AWS SES (for OTP/verification emails)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-access-key
AWS_SES_SECRET_ACCESS_KEY=your-secret-key
AWS_SES_FROM_EMAIL=noreply@opsengine.enterprise

# Session / auth
NEXTAUTH_SECRET=your-32-char-random-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
