# ==============================================================================
# OpsEngine — Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or configure in Vercel / Render Environment Variables).
# Never commit `.env` or production credentials to source control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Render)
# ------------------------------------------------------------------------------
# Pooled connection string (with PgBouncer/Neon pooler) used by Next.js Serverless runtime
DATABASE_URL="postgresql://opsengine:opsengine@localhost:5432/opsengine?sslmode=require"

# Direct unpooled connection URL used for Prisma schema migrations
DIRECT_URL="postgresql://opsengine:opsengine@localhost:5432/opsengine?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SESSION & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Mandatory 32+ character high-entropy cryptographic secret for session signing & CSRF
NEXTAUTH_SECRET="replace-with-minimum-32-chars-random-secret-key-for-production!"

# Application public URL (e.g., https://opsengine.vercel.app or https://opsengine.onrender.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application semantic version
APP_VERSION="1.46.2"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 / SSO (Postponed for initial host; mock enabled by default)
# ------------------------------------------------------------------------------
# Set to "false" when live Google Cloud Console credentials are provided
MOCK_GOOGLE_SSO="true"
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-your-secret-key"
# GOOGLE_OAUTH_REDIRECT_URI="https://your-domain.com/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Cloudflare R2 - 100% S3 Compatible, Zero Egress Fees)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="opsengine-documents"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-yourdomain.r2.dev"

# ------------------------------------------------------------------------------
# 5. OUTBOUND EMAIL (AWS SES / Resend)
# ------------------------------------------------------------------------------
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY_ID="your-access-key"
AWS_SES_SECRET_ACCESS_KEY="your-secret-key"
AWS_SES_FROM_EMAIL="noreply@opsengine.enterprise"

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Optional - Stripe & Razorpay)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# RAZORPAY_KEY_ID="rzp_live_..."
# RAZORPAY_KEY_SECRET="..."

# ------------------------------------------------------------------------------
# 7. AI ASSISTANT & GUARDRAILS (Optional - Google Gemini)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 8. DISASTER RECOVERY & BACKUPS
# ------------------------------------------------------------------------------
# Passphrase used for AES-256-CBC encryption of nightly pg_dump archives
BACKUP_ENCRYPTION_KEY="your-super-secure-32-byte-passphrase-for-backup-aes"
